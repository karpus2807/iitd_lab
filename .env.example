# LabWatch — copy to .env and adjust.

# --- Core ---
LABWATCH_ENV=production
LABWATCH_SECRET_KEY=change-this-to-a-long-random-string
LABWATCH_API_HOST=0.0.0.0
LABWATCH_API_PORT=8000
LABWATCH_PUBLIC_URL=http://localhost

# --- Database ---
DATABASE_URL=postgresql+asyncpg://labwatch:labwatch@db:5432/labwatch
# Local development without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./labwatch.db

# --- Bootstrap admin (created only if no users exist) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
ADMIN_EMAIL=admin@example.edu

# --- Agent / heartbeat ---
HEARTBEAT_INTERVAL_SECONDS=30
OFFLINE_AFTER_SECONDS=90
UNHEALTHY_AFTER_SECONDS=180
REQUIRE_AGENT_APPROVAL=false

# --- Metrics retention ---
METRICS_RAW_RETENTION_DAYS=30
METRICS_HOURLY_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=0
AGENT_LOG_RETENTION_DAYS=90

# --- SMTP (leave blank to disable email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=labwatch@example.edu
SMTP_STARTTLS=true
SMTP_ENABLED=false

# --- Frontend ---
VITE_API_BASE=/api

# --- Campus HTTP proxy (image build: pip / npm). Leave blank off-campus. ---
# HTTP_PROXY=http://10.10.78.21:3128/
# HTTPS_PROXY=http://10.10.78.21:3128/
# NO_PROXY=localhost,127.0.0.1,::1,db

# --- GitHub updater (Admin → Updates) ---
LABWATCH_GITHUB_REPO=karpus2807/iitd_lab
LABWATCH_UPDATES_ENABLED=true
LABWATCH_UPDATES_BUILDS=3
