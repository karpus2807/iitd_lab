# LabWatch agent configuration
# Copy to /etc/labwatch-agent/config.toml (Linux)
# or C:\ProgramData\LabWatch\config.toml (Windows)

[server]
url = "http://hobbit2.cse.iitd.ac.in"
registration_token = "created-by-installer"
inventory_id = "12345/2012/12"

[agent]
# Optional stable override. If empty, the agent generates and stores a UUID.
id = ""
# Alive ping (seconds). Live charts = metric_interval. Full HW scan = inventory_interval.
heartbeat_interval = 60
metric_interval = 180
inventory_interval = 3600

[tls]
verify = true
ca_file = ""

[logging]
level = "INFO"
